rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validRequestFields(data) {
      return data.keys().hasOnly([
        'userId',
        'serviceId',
        'serviceTitle',
        'name',
        'email',
        'contact',
        'details',
        'preferredDate',
        'status',
        'createdAt'
      ])
      && data.userId is string
      && data.userId == request.auth.uid
      && data.userId.size() > 0
      && data.userId.size() <= 128
      && data.serviceId is string
      && data.serviceId.size() > 0
      && data.serviceId.size() <= 200
      && data.serviceTitle is string
      && data.serviceTitle.size() > 0
      && data.serviceTitle.size() <= 200
      && data.name is string
      && data.name.size() >= 2
      && data.name.size() <= 80
      && data.email is string
      && data.email.size() >= 3
      && data.email.size() <= 254
      && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
      && data.contact is string
      && data.contact.size() >= 5
      && data.contact.size() <= 120
      && data.details is string
      && data.details.size() >= 20
      && data.details.size() <= 2000
      && data.preferredDate is string
      && data.preferredDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && data.status == 'pending'
      && data.createdAt is timestamp;
    }

    match /requests/{requestId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && validRequestFields(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.keys().hasOnly([
          'userId',
          'serviceId',
          'serviceTitle',
          'name',
          'email',
          'contact',
          'details',
          'preferredDate',
          'status',
          'createdAt'
        ]);
      allow delete: if false;
    }

    function validProfileFields(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'department', 'createdAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'department', 'createdAt'])
        && data.uid is string && data.uid == userId && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 80
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && data.email == request.auth.token.email
        && data.department is string && data.department.size() <= 100
        && data.createdAt is timestamp;
    }

    match /profiles/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && validProfileFields(request.resource.data, userId)
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && request.auth.uid == userId
        && resource.data.uid == userId
        && validProfileFields(request.resource.data, userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'department']);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
