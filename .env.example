# انسخ القيم إلى ملف .env.local محليًا ولا ترفع الملف إلى Git.
# هذه قيم Web Firebase العامة فقط؛ لا تضع service-account أو مفاتيح Admin هنا.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true للنشر خارج بيئة التطوير؛ الصور موجودة داخل public/images.
VITE_PORTABLE_ASSETS=true
