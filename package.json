{
  "name": "student-services-marketplace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22.20.0" },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --project demo-student-marketplace --only firestore \"env RUN_FIREBASE_RULES_TESTS=1 vitest run tests/firestore.rules.test.js\""
  },
  "dependencies": {
    "firebase": "13.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "6.3.0",
    "firebase-tools": "15.36.0",
    "jsdom": "31.0.1",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
